---
import { Image } from 'astro:assets'
import SocialIcons from './SocialIcons.astro'

const { fullName, institute, profilePicture } = Astro.props
---
<div class='flex-1'>
  <h1 class='text-4xl font-bold mb-4'>
    Welcome! I'm <span class='text-secondary'>{fullName}</span>
  </h1>

  <!-- Subtitle -->
  <p class='text-xl text-gray-600 mb-4'>
    {institute}
  </p>

  <!-- Mission blurb -->
  <p class='text-lg mb-6'>
    Passionate about the design and evaluation of bridges and other structures. Experinced in bride evaluation using non-destructive evaluation (NDE), bridge load testing, and load rating(AASHTO).
  </p>

  <div class='flex gap-4'>
    <SocialIcons />
  </div>
</div>

<div class='size-60 lg:block hidden-0'>
  <Image
    src={profilePicture}
    alt={fullName}
    class='w-full h-full mask mask-circle object-cover'
  />
</div>
